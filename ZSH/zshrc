# ==============================================================================
# ~/.zshrc - Main Initialization Loader
# ==============================================================================

# 1. Enable Powerlevel10k instant prompt (MUST BE FIRST)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# 2. Define Oh My Zsh and Theme
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# 3. Load Environment Variables and Plugins (MUST BE LOADED BEFORE OMZ)
[ -f ~/.config/zsh/exports.zsh ] && source ~/.config/zsh/exports.zsh
[ -f ~/.config/zsh/plugins.zsh ] && source ~/.config/zsh/plugins.zsh

# 4. Initialize Oh My Zsh
source $ZSH/oh-my-zsh.sh

# 5. Load Aliases and Functions (MUST BE LOADED AFTER OMZ TO OVERRIDE)
[ -f ~/.config/zsh/aliases.zsh ] && source ~/.config/zsh/aliases.zsh
[ -f ~/.config/zsh/functions.zsh ] && source ~/.config/zsh/functions.zsh

# 6. Load Powerlevel10k configuration
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
. "$HOME/.cargo/env"
